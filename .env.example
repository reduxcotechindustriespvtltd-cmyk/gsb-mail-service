PORT=4000
NODE_ENV=development

# Shared secret — must match MAIL_SERVICE_API_KEY in admin_crm's .env.
MAIL_SERVICE_API_KEY=replace_with_a_random_secret

# --- SMTP (Nodemailer) ---
# Leave SMTP_HOST unset in development to auto-use a throwaway Ethereal test
# inbox (a preview URL is logged per email sent). Required in production —
# the service refuses to start sending real mail without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="GSB Holidays <bookings@gsbholidays.com>"

# --- Branding (used in email templates + PDF invoice header) ---
BRAND_NAME="GSB Holidays"
BRAND_LOGO_PATH=./assets/logo.png
BRAND_SUPPORT_EMAIL=gsbholidays@gmail.com
BRAND_SUPPORT_PHONE=+91 84529 89850
